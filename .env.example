# Copy to .env and fill in. Never commit .env.

# development | production | test  (production enables HSTS and Secure cookies)
APP_ENV=development

# --- Gemini -------------------------------------------------------------------
# Server-side only; never sent to the browser. Chat returns NOT_CONFIGURED without it.
GEMINI_API_KEY=
# Required. No default in code. Use a current stable model id from
# https://ai.google.dev/gemini-api/docs/models (verified at deployment time), e.g. a
# "gemini-3.x-flash" id. The app checks the id once at startup and reports it in /health.
GEMINI_MODEL=
# Seconds to wait for the first chunk and between chunks.
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.25
LLM_MAX_OUTPUT_TOKENS=1200
# Gemini 2.5 models only: thinking tokens before the answer. 0 = off (fastest, avoids
# first-token timeouts); leave empty for the model default. Leave empty for other models.
LLM_THINKING_BUDGET=

# --- Knowledge ----------------------------------------------------------------
# Folder of Markdown knowledge files.
KNOWLEDGE_DIR=knowledge
# How often (seconds) to check for edited files. 0 disables automatic reload.
KB_RELOAD_CHECK_SECONDS=5
# Max estimated tokens of knowledge sent with one question.
KB_MAX_CONTEXT_TOKENS=6000
# Max estimated tokens for the whole request (system + history + knowledge + question).
PROMPT_MAX_INPUT_TOKENS=12000

# --- Storage ------------------------------------------------------------------
# sqlite (default) or memory (no persistence; for tests/demos)
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/chat.db
# Conversations older than this are deleted (checked at startup and hourly).
SESSION_TTL_DAYS=30
# Max stored messages (user + assistant rows) sent to the model as history.
MAX_HISTORY_MESSAGES=12
# Max characters per user message.
MAX_MESSAGE_LENGTH=4000

# --- Security -----------------------------------------------------------------
# Long random string used to sign the browser cookie. Required in production.
SESSION_SECRET=
# Comma-separated exact origins allowed for cross-origin API calls (empty = same-origin only).
ALLOWED_ORIGINS=
# Messages per minute, per IP and per session.
RATE_LIMIT_PER_MINUTE=10
# Messages per session per day.
DAILY_MESSAGE_CAP=200
# Enables /api/admin/* when set (send it in the X-Admin-Key header). Empty = admin routes return 404.
ADMIN_API_KEY=

# --- Logging & server ---------------------------------------------------------
LOG_LEVEL=INFO
# Keep false: user message text is not written to logs.
LOG_MESSAGE_CONTENT=false
PORT=8000
